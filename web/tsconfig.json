{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": ["vite/client"],
    "paths": {
      "@components/*": ["../../desktop/desktop/src/components/*"],
      "@shared/types": ["../../desktop/desktop/src/types"],
      "@shared/utils/*": ["../../desktop/desktop/src/utils/*"],
      "@shared/hooks/*": ["../../desktop/desktop/src/hooks/*"],
      "@shared/constants": ["../../desktop/desktop/src/constants"],
      "@platform": ["./src/platform/index"],
      "@identity/*": ["./src/identity/*"]
    }
  },
  "include": ["src", "../../desktop/desktop/src/components", "../../desktop/desktop/src/utils", "../../desktop/desktop/src/hooks"]
}
